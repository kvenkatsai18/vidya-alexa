# Copy to deploy/.env on the server (never commit it).

# Hostnames that point at the server's static IP. No domain? Use sslip.io, e.g. for IP 3.91.20.7:
#   mcp.3-91-20-7.sslip.io and device.3-91-20-7.sslip.io
MCP_DOMAIN=mcp.example.com
DEVICE_DOMAIN=device.example.com
BUDDY_PUBLIC_URL=https://mcp.example.com

# Required on a public server. Generate with: openssl rand -hex 24
BUDDY_ACCESS_TOKEN=

# Device page login. Hash with: docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
# Docker Compose treats "$" as a variable, so write each "$" in the hash as "$$".
DEVICE_USER=family
DEVICE_PASSWORD_HASH=

# Amazon Nova on Amazon Bedrock. On EC2 with an instance role there are no keys here, so set BUDDY_LLM explicitly.
BUDDY_LLM=bedrock
AWS_REGION=us-east-1
BUDDY_MODEL=us.amazon.nova-2-lite-v1:0
# Lightsail only (no instance roles): keys of a least-privilege IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Natural voice on the device page
BUDDY_TTS=polly

# Demo controls (clock, reset) stay available behind the access token. Set to off to remove them.
# BUDDY_ADMIN=off

# School sync (optional; sample class without these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
