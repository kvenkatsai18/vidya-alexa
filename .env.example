# --- AI provider (pick one; with none set, everything runs in offline mode with prepared demo content) ---
# Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...
# Amazon Bedrock (standard AWS credential chain: AWS_PROFILE / AWS_ACCESS_KEY_ID / SSO ...)
# BUDDY_LLM=bedrock
# AWS_REGION=us-east-1

# --- Natural device voice (Amazon Polly, AWS credentials) ---
# BUDDY_TTS=polly
# BUDDY_VOICE=Matthew

# --- Parent story voices (voice cloning). Without a key it runs in free test mode. ---
# ELEVENLABS_API_KEY=...
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional overrides
# BUDDY_LLM=anthropic|bedrock|offline
# BUDDY_MODEL=claude-opus-5-5
# BUDDY_EFFORT=low
# BUDDY_BRAND=Study Buddy
# BUDDY_TZ=America/Chicago
# MCP_URL=http://localhost:8787/mcp
# MCP_PORT=8787
# SIM_PORT=5173
