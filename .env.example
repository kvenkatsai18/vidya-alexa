# --- AI provider (with none set, everything runs in offline mode with prepared demo content) ---
# Amazon Bedrock, the default whenever AWS credentials exist (aws configure, AWS_PROFILE, SSO, or an instance role)
# AWS_REGION=us-east-1
# BUDDY_MODEL=us.amazon.nova-2-lite-v1:0       # conversation; any Bedrock model id with tool use
# BUDDY_GEN_MODEL=us.amazon.nova-pro-v1:0      # optional: study sets, grading, stories (defaults to BUDDY_MODEL)
# Alternative: Claude via the Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...

# --- Natural device voice (Amazon Polly, AWS credentials) ---
# BUDDY_TTS=polly
# BUDDY_VOICE=Matthew

# --- School sync (Google Classroom, read-only). Without these it uses a sample class. ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# BUDDY_PUBLIC_URL=http://localhost:8787   # OAuth redirect: <this>/school/oauth/callback

# Optional overrides
# BUDDY_LLM=anthropic|bedrock|offline
# BUDDY_EFFORT=low
# BUDDY_BRAND=Study Buddy
# BUDDY_TZ=America/Chicago
# MCP_URL=http://localhost:8787/mcp
# MCP_PORT=8787
# SIM_PORT=5173

# --- Hosting (see docs/DEPLOY_AWS.md) ---
# MCP_HOST=0.0.0.0
# SIM_HOST=0.0.0.0
# BUDDY_ACCESS_TOKEN=...      # required on a public server: clients send "Authorization: Bearer <token>"
# BUDDY_DATA_DIR=/data
